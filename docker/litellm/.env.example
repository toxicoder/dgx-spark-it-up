# --- LITELLM PROXY CONFIGURATION ---
# Your admin key for the proxy (must start with sk-)
# Generate a secure master key: openssl rand -base64 32 | head -c 32
# Example: sk-proj-abcdefghijklmnop123456789
LITELLM_MASTER_KEY=sk-admin-1234

# --- DATABASE CONFIGURATION ---
# PostgreSQL credentials for LiteLLM backend storage
# IMPORTANT: Copy this file to .env and customize before deploying

# PostgreSQL username for the LiteLLM database
POSTGRES_USER=llmproxy

# PostgreSQL password for the LiteLLM database
# IMPORTANT: Generate a strong password using:
#   openssl rand -base64 32
#   or: pwgen -s 32 1
POSTGRES_PASSWORD=replace_with_secure_password

# PostgreSQL database name for LiteLLM
POSTGRES_DB=litellm

# --- DATABASE CONNECTION STRING ---
# Full PostgreSQL connection URL for LiteLLM
# Format: postgresql://user:password@host:port/database?sslmode=mode
# The 'host' value 'db' refers to the docker-compose service name
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable

# --- PROVIDER API KEYS ---
# Add the API keys for the models you plan to proxy
# You can leave unused keys empty or omit them

# OpenAI API Key (required for OpenAI models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic API Key (required for Claude models)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (required for Gemini models)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# --- OPTIONAL SETTINGS ---
# Set to 'true' to manage models via the LiteLLM UI (requires database)
# Note: If you change this, also update STORE_MODEL_IN_DB in docker-compose.yml
STORE_MODEL_IN_DB=false

# --- PORT CONFIGURATION ---
# The port on your host where LiteLLM will be accessible
# Default: 4000
LITELLM_PORT=4000

# --- NGC/NVIDIA NIM CONFIGURATION ---
# Your NGC API key for accessing NVIDIA NIM models
# Get from: https://catalog.ngc.nvidia.com/api-keys
NGC_API_KEY=your_ngc_api_key_here

# Local cache directory for NIM models
# Default: $HOME/.cache/nim
LOCAL_NIM_CACHE=$HOME/.cache/nim

# --- GPU CONFIGURATION ---
# GPU allocation for inference services
# Using --gpus "all" to share single GPU across containers
# Docker and NVIDIA Container Toolkit handle resource allocation
# Options: "all" or "device=0" for specific GPU
GPU_RESOURCE=all

# --- PORT MAPPING ---
# Port mappings for inference services
OLLAMA_PORT=11434
NIM_LLAMA_PORT=8000
NIM_QWEN_PORT=8001

# --- NIM SETTINGS ---
# Shared memory size for NIM containers (prevents CUDA out of memory)
NIM_SHM_SIZE=16GB

# --- ENVIRONMENT FILE NOTES ---
# 1. This file should be named '.env' (no file extension)
# 2. Copy .env.example to .env and customize: cp .env.example .env
# 3. Never commit the .env file to version control
# 4. All variables are optional with defaults specified in docker-compose.yml
# 5. API keys can be loaded from environment variables using: os.environ/VAR_NAME
#    Example in litellm_config.yaml: api_key: os.environ/OPENAI_API_KEY