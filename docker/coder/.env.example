# --- DATABASE CONFIGURATION ---
# These credentials will be used to initialize the Postgres container
# IMPORTANT: Copy this file to .env and fill in actual values before deploying

# PostgreSQL username for the Coder database
# Recommendation: Use a secure username (avoid common names like 'postgres' or 'admin')
POSTGRES_USER=coder_admin

# PostgreSQL password for the Coder database
# IMPORTANT: Generate a strong password using:
#   openssl rand -base64 32
#   or: pwgen -s 32 1
POSTGRES_PASSWORD=generate_a_strong_password_here

# PostgreSQL database name for Coder
POSTGRES_DB=coder

# --- DATABASE CONNECTION STRING ---
# This is the full connection URL for Coder to connect to PostgreSQL
# Format: postgresql://user:password@host:port/database?sslmode=mode
# The 'host' value 'database' refers to the docker-compose service name
CODER_PG_CONNECTION_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database/${POSTGRES_DB}?sslmode=disable

# --- CODER SERVICE CONFIGURATION ---
# The URL where users and workspaces reach the Coder server
# IMPORTANT: Replace with your server's public IP address or domain name
# Examples:
#   - http://192.168.1.10:7080 (local network IP)
#   - https://coder.example.com (public domain with HTTPS)
#   - http://your-dgx-server.local:7080 (local hostname)
CODER_ACCESS_URL=http://localhost:7080

# The internal address for the Coder binary to listen on
# Default: 0.0.0.0:7080 (listen on all interfaces)
# Change only if you need to restrict to specific interface
CODER_ADDRESS=0.0.0.0:7080

# --- DOCKER SOCKET PERMISSIONS ---
# Get your host's Docker group ID by running:
#   getent group docker | cut -d: -f3
# If the docker group doesn't exist or you don't need Docker access, comment out
DOCKER_GROUP_ID=$(getent group docker 2>/dev/null | cut -d: -f3)

# --- TELEMETRY & UPDATES ---
# CODER_TELEMETRY_ENABLE: Set to 'false' to disable anonymous telemetry
# CODER_UPDATE_CHECK: Set to 'false' to disable automatic update notifications
CODER_TELEMETRY_ENABLE=false
CODER_UPDATE_CHECK=false

# --- PORT CONFIGURATION ---
# The port on your host where Coder will be accessible
# Default: 7080
CODER_PORT=7080

# --- POSTGRES EXTRA CONFIGURATION (Optional) ---
# PostgreSQL connection timeout in seconds
# POSTGRES_CONNECT_TIMEOUT=10

# --- ENVIRONMENT FILE NOTES ---
# 1. This file should be named '.env' (no file extension)
# 2. Copy .env.example to .env and customize: cp .env.example .env
# 3. Never commit the .env file to version control
# 4. All variables are optional with defaults specified in docker-compose.yml
